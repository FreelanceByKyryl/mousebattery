<Window x:Class="MouseCharge.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseCharge" Width="300" Height="139"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Grid Width="300" Height="139">
            <Grid Margin="10,10,10,14">
                <Border x:Name="Surface" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                          Color="#10141C" Opacity=".42" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
                <Border x:Name="Outline" CornerRadius="18" BorderThickness="1" />

                <Grid Margin="15,13,15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="IconSurface" Height="34" CornerRadius="10"
                                VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20" IsHitTestVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="MouseGlyph" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M12,3 C15.4,3 18.2,5.8 18.2,9.2 L18.2,14.8 C18.2,18.3 15.4,21 12,21 C8.6,21 5.8,18.3 5.8,14.8 L5.8,9.2 C5.8,5.8 8.6,3 12,3 Z M12,6.5 L12,10" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="MouseName" Text="MouseCharge" FontSize="14"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ConnectionDot" Height="6" Width="6"
                                         Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionText" Grid.Column="1"
                                           Text="Checking devices…" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="8,-5,0,0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="LevelText" Text="—" FontSize="34" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="PercentMark" Text="%" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom" Margin="1,0,0,6" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ClipToBounds="True">
                        <Border x:Name="ProgressRail" CornerRadius="2" />
                        <Border x:Name="ProgressFill" CornerRadius="2" RenderTransformOrigin="0,.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BatteryNote" Text="Battery unavailable" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LastReadText" Grid.Column="1" FontSize="11"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
