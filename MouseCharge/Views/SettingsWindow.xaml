<Window x:Class="MouseCharge.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="MouseCharge Settings" Width="480" Height="640" MinWidth="410" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#F3F5F7"
        Foreground="#1B252E" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#DCE2E7" BorderThickness="0,1,0,0"
                Background="White" Padding="20,12">
            <Grid>
                <Button Content="_Diagnostics" HorizontalAlignment="Left" Click="OpenDiagnostics"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
                    <Button Content="_Save" IsDefault="True" MinWidth="76" Click="Save"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Margin="20,16,20,4">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Mouse and battery" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mouse"/>
                            <ComboBox Grid.Column="1" x:Name="MouseChoice" DisplayMemberPath="Name"
                                      AutomationProperties.Name="Mouse"/>
                            <TextBlock Grid.Row="1" Text="Refresh interval"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RefreshChoice"
                                      AutomationProperties.Name="Refresh interval">
                                <ComboBoxItem Content="30 seconds" Tag="30"/>
                                <ComboBoxItem Content="60 seconds" Tag="60"/>
                                <ComboBoxItem Content="120 seconds" Tag="120"/>
                                <ComboBoxItem Content="300 seconds" Tag="300"/>
                            </ComboBox>
                            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="Notifications"
                                      Content="Notify me when the battery is low"/>
                            <TextBlock Grid.Row="3" Text="Low battery threshold"/>
                            <Grid Grid.Row="3" Grid.Column="1"
                                  IsEnabled="{Binding IsChecked, ElementName=Notifications}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="Threshold" Minimum="1" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                        VerticalAlignment="Center" AutomationProperties.Name="Low battery threshold"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                           Text="{Binding Value, ElementName=Threshold, StringFormat={}{0:0}%}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Theme"/>
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="ThemeChoice"
                                      AutomationProperties.Name="Widget theme">
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Widget size"/>
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="Scale" Minimum="0.75" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05"
                                    LargeChange="0.25" VerticalAlignment="Center"
                                    AutomationProperties.Name="Widget size"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"
                                       Text="{Binding Value, ElementName=Scale, StringFormat={}{0:P0}}"/>
                            <TextBlock Grid.Row="2" Text="Opacity"/>
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="WidgetOpacity" Minimum="0.25" Maximum="1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05"
                                    LargeChange="0.25" VerticalAlignment="Center" AutomationProperties.Name="Opacity"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"
                                       Text="{Binding Value, ElementName=WidgetOpacity, StringFormat={}{0:P0}}"/>
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="Transparent"
                                      Content="Transparent background"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Desktop" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="TopmostChoice" Content="Always on top"/>
                            <CheckBox Grid.Column="1" x:Name="LockPosition" Content="Lock widget position"/>
                            <CheckBox Grid.Row="1" x:Name="ClickThroughChoice" Content="Click-through"
                                      ToolTip="Use the system tray to change settings while click-through is active."/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="StartWithWindowsChoice"
                                      Content="Start with Windows"/>
                        </Grid>
                        <Button x:Name="ResetButton" Content="Reset widget position" HorizontalAlignment="Left"
                                Margin="0,7,0,0" Click="QueuePositionReset"/>
                        <TextBlock x:Name="ResetMessage" Text="The widget will move to its default position when you save."
                                   Visibility="Collapsed" TextWrapping="Wrap" Foreground="#4D5B67" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
