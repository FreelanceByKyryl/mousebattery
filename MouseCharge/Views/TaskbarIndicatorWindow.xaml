<Window x:Class="MouseCharge.Views.TaskbarIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseCharge battery" Width="62" Height="26"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Indicator" Visibility="Hidden">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Viewbox Width="18" Height="14" VerticalAlignment="Center">
            <Canvas Width="22" Height="14">
                <Path x:Name="MouseGlyph" StrokeThickness="1.35" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M6,1.75 H14.65 C18.25,1.75 20.65,3.85 20.65,7
                            C20.65,10.15 18.25,12.25 14.65,12.25 H6
                            C3.4,12.25 1.35,10.2 1.35,8.05 V5.95
                            C1.35,3.8 3.4,1.75 6,1.75 Z
                            M9.3,1.75 V12.25 M1.35,7 H3 M7.45,7 H9.3
                            M4.25,5.85 H6.2 C6.9,5.85 7.45,6.35 7.45,7
                            C7.45,7.65 6.9,8.15 6.2,8.15 H4.25
                            C3.55,8.15 3,7.65 3,7 C3,6.35 3.55,5.85 4.25,5.85 Z" />
            </Canvas>
        </Viewbox>
        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="LevelText" Text="—" FontSize="14" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       AutomationProperties.Name="Battery unavailable" />
        </Viewbox>
    </Grid>
</Window>
