<Window x:Class="MouseCharge.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseCharge" Width="245" Height="103"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Grid Width="245" Height="103">
            <Grid Margin="10,10,10,12">
                <Border x:Name="Surface" CornerRadius="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                          Color="#101726" Opacity=".48" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
                <Border x:Name="Rim" CornerRadius="25" BorderThickness="1.35" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#609AFF"
                                          Opacity=".6" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>

                <Grid x:Name="BatteryReading" Margin="13,7" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="47" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="37" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MouseBadge" Width="45" Height="45" CornerRadius="22.5"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Viewbox Width="25" Height="31" Stretch="Uniform">
                                <Path x:Name="MouseGlyph" StrokeThickness="1.35" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M14.4,1.7 C8.3,.6 4.6,2.7 3.3,6.4 C2,10 3.1,13.1 4.6,16.3 C5.8,19 4.3,21.6 4.5,24.3 C4.7,28.8 8.6,31.3 13,31.2 C18.5,31.1 22.9,27.1 23.3,22.4 C23.8,18.2 21.4,14.8 22.1,11.2 C23.3,5 19.7,2.6 14.4,1.7 Z
                                            M14,1.9 L13.9,5.6 M13.6,11.9 L13.4,15.5 M4.7,16.5 C10,15.4 16.9,16.7 22.3,14.2
                                            M13.8,5.7 C12.7,5.6 12.1,6.5 12,7.5 L11.8,9.9 C11.7,11 12.3,11.8 13.4,11.9 C14.5,12 15.2,11.2 15.3,10.1 L15.5,7.7 C15.6,6.6 15,5.8 13.8,5.7 Z
                                            M9.3,20.1 l1.2,-.7 1.2,.7 v1.4 l-1.2,.7 -1.2,-.7 Z M14.4,20.1 l1.2,-.7 1.2,.7 v1.4 l-1.2,.7 -1.2,-.7 Z M11.9,24.4 l1.2,-.7 1.2,.7 v1.4 l-1.2,.7 -1.2,-.7 Z" />
                            </Viewbox>
                        </Border>

                        <Canvas Grid.Column="2" Width="37" Height="19" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Rectangle x:Name="GaugeCase" Canvas.Left="1" Canvas.Top="2"
                                       Width="31" Height="15" RadiusX="3.5" RadiusY="3.5"
                                       StrokeThickness="1.4" Opacity=".76" />
                            <Rectangle x:Name="GaugeTerminal" Canvas.Left="34" Canvas.Top="7"
                                       Width="2.5" Height="5" RadiusX="1" RadiusY="1" Opacity=".76" />
                            <Border x:Name="GaugeFill" Canvas.Left="4" Canvas.Top="5"
                                    Width="25" Height="9" CornerRadius="1.5" RenderTransformOrigin="0,.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="GaugeScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Canvas>

                        <TextBlock x:Name="LevelText" Grid.Column="4" Text="—"
                                   FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="BatteryNote" Grid.Row="1" Text="Battery unavailable" FontSize="10.5"
                               Margin="2,0,2,1" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
