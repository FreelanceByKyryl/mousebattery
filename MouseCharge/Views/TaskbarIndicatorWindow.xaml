            </Canvas>
        </Viewbox>
        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="LevelText" Text="—" FontSize="14" FontWeight="SemiBold"
