<Window x:Class="MouseCharge.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="MouseCharge Settings" Width="460" Height="315" MinWidth="410" MinHeight="270"
        WindowStartupLocation="CenterScreen" Background="#F3F5F7"
        Foreground="#1B252E" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <Border Margin="20,16,20,12" Padding="12" Background="White" BorderBrush="#DCE2E7"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mouse"/>
                    <ComboBox Grid.Column="1" x:Name="MouseChoice" DisplayMemberPath="Name"
                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                              AutomationProperties.Name="Mouse"/>
                    <TextBlock Grid.Row="1" Text="Refresh interval"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RefreshChoice"
                              AutomationProperties.Name="Refresh interval">
                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                        <ComboBoxItem Content="60 seconds" Tag="60"/>
                        <ComboBoxItem Content="120 seconds" Tag="120"/>
                        <ComboBoxItem Content="300 seconds" Tag="300"/>
                    </ComboBox>
                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="Notifications"
                              Content="Notify me when the battery is low"/>
                    <TextBlock Grid.Row="3" Text="Low battery threshold"/>
                    <Grid Grid.Row="3" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=Notifications}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Threshold" Minimum="1" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center" AutomationProperties.Name="Low battery threshold"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=Threshold, StringFormat={}{0:0}%}"/>
                    </Grid>
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#DCE2E7" Height="1" Margin="0,6"/>
                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="StartWithWindowsChoice"
                              Content="Start with Windows"/>
                </Grid>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#DCE2E7" BorderThickness="0,1,0,0"
                Background="White" Padding="20,12">
            <Grid>
                <Button Content="_Diagnostics" HorizontalAlignment="Left" Click="OpenDiagnostics"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
                    <Button Content="_Save" IsDefault="True" MinWidth="76" Click="Save"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
