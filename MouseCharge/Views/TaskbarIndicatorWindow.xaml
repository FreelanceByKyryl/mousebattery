                    <Path.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-90" CenterX="16" CenterY="16" />
                            <TranslateTransform X="1" Y="-6" />
                        </TransformGroup>
                    </Path.RenderTransform>
